  "LYRICS_7": [
    {
      "start": "0:00:86",
      "lyric": "it's so funny how hindsight,",
    },
    {
      "start": "0:03:98",
      "lyric": "is super clear vision",
    },
    {
      "start": "0:06:07",
      "lyric": "it's so funny how you hide,",
