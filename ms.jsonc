  "VISUAL_NOVEL_SO_REMIND_ME_WHAT_HAPPENED": "jadi ingatkan aku, apa yg jd",
  "VISUAL_NOVEL_THAT_MIGHT_BE_RIGHT_THAT_MIGHT_BE_WRONG_WHAT_NEXT": "mungkin betul, mungkin salah. lepastu apa?",
  "VISUAL_NOVEL_OK_COULD_BE_WHAT_HAPPENED_BUT_I_WONT_TELL_YOU_WHAT_THEN": "ok... mungkin tu yg jd tp aku takkan bgtau ko. lepastu apa?",
  "VISUAL_NOVEL_AND_FINALLY": "dan akhirnya?",
  "VISUAL_NOVEL_WE_BLESSED_THE_STATUE": "kita rahmati patung tu",
