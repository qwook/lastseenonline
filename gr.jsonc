  "VISUAL_NOVEL_HOLD_ON_MY_MEMORY_IS_JUST_FUZZY": "περίμενε.. η μνήμη μου είναι απλα λίγο θολή...",
  "VISUAL_NOVEL_SURE_TAKE_YOUR_TIME_YOU_CAN_PROBABLY_FIND_SOMETHING_ON_YOUR_COMPUTER_TO_HELP_YOU_REFRESH_YOUR_MEMORY": "βεβαίως. πάρε τον χρόνο σου~ λογικά μπορείς να βρεις κάτι στον υπολογιστή που θα σε βοηθήσει να φρεσκάρεις την μνήμη σου",
  "VISUAL_NOVEL_THANKS_ILL_TRY_AGAIN": "ευχαριστώ... θα δοκιμάσω ξανα",
  "VISUAL_NOVEL_I_DONT_THINK_THATS_IT": "δεν νομίζω πως είναι έτσι...",
  "VISUAL_NOVEL_HMM_OKAY_I_BELIEVE_U_FOR_NOW_YOU_NEED_TO_REGISTER_A_NEW_ACCOUNT_THE_INVITE_CODE_IS_NEVERLAND": "χμμ... εντάξει σε πιστευώ. προς το παρόν. πρέπει να δημιουργήσεις έναν νέο λογαριασμό, ο κωδικός πρόσκλησης είναι {0}",
  "VISUAL_NOVEL_HMM_HEY_LIZ_IMMA_BRB": "χμμ... ε Λιζ.. θα φύγω για λίγο χαχαΧΑΧΑ... τα λέμε",
  "LYRICS_1": [
    {
      "start": "0:00:46",
      "lyric": "ένα ποτάμι που κελαρύζει",
    },
    {
      "start": "0:03:07",
      "lyric": "μια λίμνη που λάμπει",
    },
    {
      "start": "0:05:11",
      "lyric": "μια καυτή άνοιξη ξεχυ- ξεχυλίζει",
    },
    {
      "start": "0:10:28",
      "lyric": "ολα τα τρία πράγμα, τα ξέρω",
    },
    {
      "start": "0:13:90",
      "lyric": "Ξέρω...",
    },
  ],
  "LYRICS_2": [
    {
      "start": "0:00:40",
      "lyric": "δύο χέρια που κρατιούνται πάνω σε μια",
    },
    {
      "start": "0:05:57",
      "lyric": "παλιά ιστορία, κακογραμμένη",
    },
    {
      "start": "0:09:92",
      "lyric": "μπορούμε -",
    },
    {
      "start": "0:11:40",
      "lyric": "να πάρουμε τον έλεγχο;",
    },
    {
      "start": "0:13:01",
      "lyric": "Θέλω να τα αφήσω όλα αυτά πίσω μου",
    },
  ],
  "LYRICS_3": [
    {
      "start": "0:00:61",
      "lyric": "ξύπνα στις 7 Π.Μ",
    },
    {
      "start": "0:03:96",
      "lyric": "είναι σαν παράδεισος ξανά",
    },
    {
      "start": "0:07:48",
      "lyric": "βλέπω να χαμογελάς φίλε μου",
    },
    {
      "start": "0:10:86",
      "lyric": "και δεν θέλω αυτό να σταματήσει",
    },
    {
      "start": "0:13:92",
      "lyric": "η παρούσα στιγμή θα φύγει γρήγορα",
    },
    {
      "start": "0:17:38",
      "lyric": "η πόλη και οι δρόμοι γεμάτοι κόσμο",
    },
    {
      "start": "0:21:13",
      "lyric": "όποιον και αν γνωρίσεις",
    },
    {
      "start": "0:24:23",
      "lyric": "κάποια μέρα θα φύγει",
    },
  ],
  "LYRICS_4": [
    {
      "start": "0:01:11",
      "lyric": "είμαι ένα ποτό που ήπιες;",
    },
    {
      "start": "0:05:21",
      "lyric": "είμαι ένα σνακ που έφαγες (οχτώ)",
    },
    {
      "start": "0:09:61",
      "lyric": "είμαι ένα πράγμα που έχασες πριν καιρό;",
    },
    {
      "start": "0:14:69",
      "lyric": "έχασες πριν απο πολύ καιρό",
    },
  ],
  "LYRICS_5": [
    {
      "start": "0:00:71",
      "lyric": "Δεν θέλω να θαφτώ",
    },
    {
      "start": "0:04:67",
      "lyric": "έξι πόδια κάτω απο το έδαφος",
    },
    {
      "start": "0:08:61",
      "lyric": "αν δεν είσαι εσυ εκεί",
    },
    {
      "start": "0:12:40",
      "lyric": "δεν θέλω να είμαι μόνος",
    },
    {
      "start": "0:15:75",
      "lyric": "Δεν θέλω να φύγω απο αυτόν τον κόσμο",
    },
    {
      "start": "0:20:07",
      "lyric": "αν δεν είσαι εσύ στο πλευρό μου",
    },
    {
      "start": "0:23:34",
      "lyric": "οχι, δεν θέλω να πεθάνω",
    },
    {
      "start": "0:26:80",
      "lyric": "χωρίς εσένα",
    },
  ],
  "LYRICS_6": [
    {
      "start": "0:01:10",
      "lyric": "*χυλοπίτες κιθάρας*",
    },
    {
      "start": "0:03:73",
      "lyric": "ο, γαμώτο, αμ...",
    },
    {
      "start": "0:06:00",
      "lyric": "*STRUM ΚΙΘΑΡΑΣ*",
    },
    {
      "start": "0:07:52",
      "lyric": "(ψιθιρίζει) λοιπόν",
    },
    {
      "start": "0:08:63",
      "lyric": "μόνο μια ευκαιρία,",
    },
    {
      "start": "0:11:82",
      "lyric": "και ένας χορός",
    },
    {
      "start": "0:14:88",
      "lyric": "είναι λίγο ντροπιαστικό",
    },
    {
      "start": "0:17:36",
      "lyric": "εφηβικός έρωτας",
    },
    {
      "start": "0:19:98",
      "lyric": "*η μουσική σταματάει* ακούγετε σαν",
    },
    {
      "start": "0:20:96",
      "lyric": "το τέλος όμως",
    },
    {
      "start": "0:22:55",
      "lyric": "μήπως πρέπει να γράψω",
    },
    {
      "start": "0:23:21",
      "lyric": "την αρχή",
    },
  ],
  "LYRICS_7": [
    {
      "start": "0:00:86",
      "lyric": "είναι πολύ αστείο το πως το handsight,",
    },
    {
      "start": "0:03:98",
      "lyric": "είναι πολύ καθαρή όραση",
    },
    {
      "start": "0:06:07",
      "lyric": "είναι πολύ αστείο το πως κρύβεσε,",
    },
    {
      "start": "0:09:28",
      "lyric": "το τι σκέφτεσε πραγματικά",
    },
    {
      "start": "0:11:46",
      "lyric": "Έχω τρία μάτια ανοιχτά τώρα",
    },
    {
      "start": "0:16:59",
      "lyric": "Δοκίμασα αλλά δεν είσαι εδώ",
    },
  ],
  "LYRICS_8": [
    {
      "start": "0:00:42",
      "lyric": "σε παρακαλώ μην λες πως τελείωσε",
    },
    {
      "start": "0:04:42",
      "lyric": "έβαλα την τύχη μου σε ένα τετράφυλλο τριφύλλι",
    },
    {
      "start": "0:11:15",
      "lyric": "μην λες οτι είναι νοσταλγία",
    },
    {
      "start": "0:16:28",
      "lyric": "Θα προτιμόυσα να μείνω στο παρελθόν αν θέλω",
    },
  ],
  "NOTES": [
    "8/24 μόλις βρήκα το παλιό μου ημερολόγιο και μου ήρθε η έμπνευση να φτιάξω μια ψηφιακή έκδοση!! ήταν περίεργο όταν το διάβαζα, πέρασα πολλά προβλήματα πριν απο 4 χρόνια και μου φαίνετε πως τα ξαναπερνάω ξανά και ξανά",
    "8/25 οι φωτογραφίες απο την digi cam μου μόλις ήρθαν!!!! τόσο ενθουσιασμένη >.<",
    "8/27 οοπσ έπρεπε να διαβάσω για ένα κουίζ!!! δεν έγραψα όσο ήθελα να γράψω....",
    "8/28 περνάω πολύ χρόνο στον υπολογιστή μου τώρα τελευταία. πρέπει να βγαίνω έξω πιο πολύ. όμως γνώρισα έναν νέο φίλο που τον λένε orion!!! μου έδειξε ένα νέο παιχνίδι σήμερα.",
    "9/2 μόλις είδα ένα post στο zanga οτι ο κεβ ng πέθανε πρόσφατα. ήταν παράξενω να το βλέπω... αισθάνθηκα σαν να μην είχα συναισθήματα. απλά ήταν. υπήρχαν πολλά σχόλια στο post. \"rip kev\" και άλλα πράγματα σαν αυτό. δεν τον πολυ-ήξερα.. δεν ξέρω πως να αισθανθώ...",
    "9/3 ξέχασα. το ντουλαπάκι του κεβ ήταν ακριβώς κάτω απο το δικό μου. συνήθως έκανα στην άκρη κάθε φορά που ερχότανε, και άκουγα την φωνή του \"γειά με συγχωρείς\". το είχα συνηθίσει. όταν έκλεινα το ντουλαπάκι, αντιλήφθηκα πως δεν τον άκουγα, και δεν χρειαζόταν να κάνω στην άκρη, και μετά έκλαψα. δεν μπορούσα να σταματήσω να κλαίω. ο θάνατος είναι τόσο τρομακτικός για εμένα. πώς μπορεί κάποιος απλα να... εξαφανιστεί;; κάθε μικρό πράγμα για αυτόν τον άνθρωπο, τα πάντα που θα έκανε την επόμενη ημέρα, ο κεβ πηγαίνοντας για μάθημα την επόμενη ημέρα ή ο κεβ που ετοιμάζονταν για την 'βδομάδα spirit για την επόμενη εβδομάδα. όλα αυτά απλά, σταματάνε.",
    "9/4 Ο Λόουσον, εμ και εγώ επισκεφθήκαμε το landess σήμερα, προς 680. κάποιος είχε βάλει έναν λευκό σταυρό στο σημείο όπου ο κεβ και ο πατέρας του τρακάρανε. έγραψα ένα γράμμα στον κεβ, και το άφησα εκεί.",
    "9/5 η μαμά μου έμαθε πως ο Λόουσον με είχε οδηγήσει στον τάφο του κεβ και νευρίασε πάρα πολυ. μου είπε στα γαμωσπασμένα αγγλικά της πως είμαι μια εγκληματίας. είπε πως χάλασα την ομορφιά της όταν γεννήθηκα και πως το λιγότερο που μπορώ να κάνω είναι να είμαι ένα καλό παιδί. έκατσα πιο πολύ στο σχολείο σήμερα στην αίθουσα υπολογιστών. μίλησα στον orion. περπάτησα σπίτι και πήγα στο δωμάτιο μου. η μαμά ήταν ήσυχη, δεν μου μίλησε καθόλου.",
    "9/6 η μαμά μου κάλεσε τους γαμημένους αστυνόμους ξανα!!! δήλωσε την εξαφάνιση μου. και σήμερα ΞΑΝΑ κάλεσε τους γαμημένους αστυνόμους. λέγοντας τους να με συλλάβουνε επειδή νόμιζε πως έπαιρνα ναρκωτικά;;; UGH WTF!!!!",
    "9/13 συγγνώμη υπολογιστή.... πέρασαν μερικές ημέρες... έτρεξα μακριά... πέρασα την 'βδομαδα στο σπίτι της εμ.. η εμ είναι μια τόσο καλή φίλη. η μαμά της εμ πήρε τηλέφωνο την δική μου μαμά. η μαμά μου και εγώ μιλήσαμε. με πήγε στο αγαπημένο μου κινέζικο μέρος για φαγητό με honey walnut shrimp. μου είπε πόσο δύσκολο είναι να πρέπει να κάνει τα πάντα μόνη της και πως δεν ξέρει πως να τα κανει... μερικές φορές μπορώ να καταλάβω την μαμά... αλλά τις περισσότερες φορές δεν την καταλαβαίνω... απλά λέει πολύ περίεργες μαλακίες μερικές φορές... καταλαβαίνω οτι με αγαπάει και οτι θέλει να μεγαλώσω σωστά... και την αγαπάω.. και λατρεύω το πόσο goofy μπορεί να είναι μερικές φορές... αλλά λέει τα πιο προσβλητικά πράγματα...",
    "10/13 η μαμά έχει φυγεί για να επισκεφθεί την γιαγιά. οπότε δεν πήγα σχολείο. ο orion μου στέλνει μερικά horror mangas λόγω του hallowen. χθες είχαμε εθιστεί ψάχνωντας ιστορίες με serial killers. με γνώρισε στον σκοτ. μπορεί να τους επισκεφτώ σύντομα.",
    "10/31 δεν θέλω να φύγω απο αυτόν τον κόσμο... αν δεν είσαι εσύ στο πλεύρο μου.....",
  ],
